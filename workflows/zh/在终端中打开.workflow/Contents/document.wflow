        <key>ActionName</key>
        <string>Run Shell Script</string>
        <key>ActionParameters</key>
        <dict>
          <key>CheckedForUserDefaultShell</key>
          <true/>
          <key>COMMAND_STRING</key>
          <string>for item in "$@"; do
  if [ -d "$item" ]; then
    open -a Terminal "$item"
  else
    open -a Terminal "$(dirname "$item")"
  fi
done
</string>
          <key>inputMethod</key>
          <integer>1</integer>
          <key>shell</key>
          <string>/bin/zsh</string>
